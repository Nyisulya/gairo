# Mazingira (development au production)
NODE_ENV=production

# Server Port
PORT=8018

# PostgreSQL Database Configuration (Dedicated User & Database)
PGUSER=gairo_user
PGPASSWORD=GairoSec2026!
PGHOST=localhost
PGPORT=5432
PGDATABASE=gairo

# PostgreSQL (Chaguo la pili kama unatumia DATABASE_URL):
# DATABASE_URL=postgresql://gairo_user:GairoSec2026!@localhost:5432/gairo
# PGSSL=false

# DeepSeek Vision AI API Key (Pata kutoka https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
